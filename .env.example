# Messenger bots
BOT_TOKEN=
TELEGRAM_BOT_ENABLED=true
MAX_BOT_TOKEN=
MAX_BOT_ENABLED=true
ADMIN_IDS=123456789,987654321

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=passports
DATABASE_URL=postgresql+asyncpg://postgres:change-me@postgres:5432/passports

# OCR Provider
OCR_PROVIDER_MODEL=yandex

# Yandex Cloud OCR
YC_FOLDER_ID=
#
# Auth (выберите ОДИН вариант):
#
# Вариант 1 — API-ключ (рекомендуется, не истекает):
#   yc iam api-key create --service-account-name <имя> --scope yc.ai.vision.execute
YC_API_KEY=
#
# Вариант 2 — OAuth токен (авто-обновление IAM каждые 12ч):
#   Получить: https://oauth.yandex.ru/authorize?response_type=token&client_id=1a6990aa636648e9b2ef855fa7bec2fb
YC_OAUTH_TOKEN=
#
# Вариант 3 — IAM токен вручную (истекает через 12ч):
#   yc iam create-token
YC_IAM_TOKEN=
YC_OCR_ENDPOINT=https://ocr.api.cloud.yandex.net/ocr/v1/recognizeText
OCR_DOCUMENT_MODEL=passport
OCR_LANGUAGE_CODES=*

# OpenRouter (vision LLM)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-flash-1.5
# Rate limit: max requests per minute (0 = unlimited)
OPENROUTER_RPM=0

# Output format templates
FORMAT_TYPE1={country}/{number}/{country}/{birth_date_long}/{gender}/{expiry_long}/{surname}/{name}
FORMAT_TYPE2=-{surname} {name} {birth_date_short}+{gender}/{country}/{doc_type} {number}/{expiry_short}

# Shared OCR module priority for Telegram and MAX (lower index = higher priority).
# OpenRouter runs first; local RupaSportRead supplements fields it misses.
# Compose uses BOT_OCR_MODULE_PRIORITY for both services. If unset, it falls back
# to MAX_OCR_MODULE_PRIORITY for compatibility, then to this hybrid default.
BOT_OCR_MODULE_PRIORITY=openrouter,rupasportread
# Deprecated compatibility fallback used only when BOT_OCR_MODULE_PRIORITY is unset.
MAX_OCR_MODULE_PRIORITY=openrouter,rupasportread
# Direct non-Compose runs read OCR_MODULE_PRIORITY from this environment value.
OCR_MODULE_PRIORITY=openrouter,rupasportread

# OCR Limits
OCR_MAX_FILE_MB=10
OCR_MAX_MEGAPIXELS=20
OCR_RATE_LIMIT_RPS=1

# PDF Processing
PDF_RENDER_DPI=200

# Storage
TMP_DIR=./tmp
STORE_SOURCE_FILES=false

# Web interface. MAX runs with WEB_ENABLED=false in Compose.
WEB_PORT=8080
WEB_ENABLED=true

# Docker image variant: light or full
BOT_VARIANT=light

# Logging
LOG_LEVEL=INFO
